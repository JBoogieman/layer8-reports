<DataSet Name="Devices">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters><QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter><QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter><QueryParameter Name="@Days"><Value>=Parameters!Days.Value</Value></QueryParameter></QueryParameters>
    <CommandText>-- Layer8 Boot times and crashes: one row per device in a collection, with its model and BIOS version, how long it
-- takes to start, and how often it stopped unexpectedly. The report groups the rows by model and BIOS version.
--
-- Parameters
--   @UserSIDs      The reader's, so the report shows only what their ConfigMgr security scopes allow. The report
--                  fills it in; 'disabled' skips the check (for testing outside SSRS).
--   @CollectionID  The collection to report on, e.g. SMS00001 (All Systems).
--   @Days          How far back to count boots and crashes. 30 by default, which is as far back as the collector
--                  keeps them unless it runs with -Days.
--
-- Needs the Layer8 boot and crash collector (collector\Layer8-BootAndCrash.ps1) running on the devices, and its
-- classes Layer8_Boot and Layer8_Crash in hardware inventory. Their views are read directly: the device list
-- above them already limits the rows to devices the reader may see.
--
-- Medians and 90th percentiles are worked out here, per device, per model and per model and BIOS version, because
-- the report server has no median. Every device row carries its model's figures; the report shows them once a group.

WITH Devices AS (
    -- The collection's devices with a client, as Fleet by model finds them, and the names it gives their models.
    SELECT
        sys.ResourceID,
        sys.Name0 AS Device,
        CASE
            WHEN cs.Manufacturer0 LIKE 'LENOVO%'                                 THEN 'Lenovo'
            WHEN cs.Manufacturer0 LIKE 'Dell%'                                   THEN 'Dell'
            WHEN cs.Manufacturer0 LIKE 'HP%' OR cs.Manufacturer0 LIKE 'Hewlett%' THEN 'HP'
            WHEN cs.Manufacturer0 LIKE 'Microsoft%'                              THEN 'Microsoft'
            WHEN cs.Manufacturer0 LIKE 'VMware%'                                 THEN 'VMware'
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Manufacturer0)), ''), 'Unknown')
        END AS Manufacturer,
        -- Lenovo's Model is a machine type code (21C5...); the name people know ("ThinkPad L14 Gen 3") is the
        -- system product's Version. Everyone else puts the name in Model.
        CASE
            WHEN cs.Manufacturer0 LIKE 'LENOVO%' AND NULLIF(LTRIM(RTRIM(csp.Version0)), '') IS NOT NULL
                 AND csp.Version0 NOT LIKE 'Lenovo' THEN LTRIM(RTRIM(csp.Version0))
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Model0)), ''), 'Unknown')
        END AS Model,
        bios.SMBIOSBIOSVersion0 AS BiosVersion,
        -- Windows by name and release, not just the build number.
        CASE
            WHEN os.Caption0 LIKE '%Server%' THEN REPLACE(os.Caption0, 'Microsoft ', '')
            WHEN os.BuildNumber0 = '26300' THEN 'Windows 11 26H2'
            WHEN os.BuildNumber0 = '26200' THEN 'Windows 11 25H2'
            WHEN os.BuildNumber0 = '26100' THEN 'Windows 11 24H2'
            WHEN os.BuildNumber0 = '22631' THEN 'Windows 11 23H2'
            WHEN os.BuildNumber0 = '22621' THEN 'Windows 11 22H2'
            WHEN os.BuildNumber0 = '22000' THEN 'Windows 11 21H2'
            WHEN os.BuildNumber0 = '19045' THEN 'Windows 10 22H2'
            WHEN os.BuildNumber0 = '19044' THEN 'Windows 10 21H2'
            WHEN os.BuildNumber0 IS NULL   THEN 'Unknown'
            WHEN TRY_CAST(os.BuildNumber0 AS int) &gt;= 22000 THEN 'Windows 11 (build ' + os.BuildNumber0 + ')'
            ELSE 'Windows 10 (build ' + os.BuildNumber0 + ')'
        END AS Windows,
        os.BuildNumber0 AS Build
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM(@UserSIDs) cs           ON cs.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM_PRODUCT(@UserSIDs) csp  ON csp.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_PC_BIOS(@UserSIDs) bios                 ON bios.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_OPERATING_SYSTEM(@UserSIDs) os          ON os.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Boots AS (
    SELECT d.ResourceID, d.Model, d.BiosVersion, b.BootStart0 AS BootStart, b.BootTimeMs0 / 1000.0 AS BootSeconds
    FROM Devices d
    JOIN v_GS_LAYER8_BOOT b ON b.ResourceID = d.ResourceID
    WHERE b.BootStart0 &gt;= DATEADD(day, -@Days, GETUTCDATE())   -- the collector's times are UTC
),
Timed AS (
    -- Boot time is Windows' own figure (Diagnostics-Performance event 100): from power on until the desktop is ready
    -- and startup has settled. Windows doesn't time every boot, so these are the boots it did.
    SELECT ResourceID, BootSeconds,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY BootSeconds) OVER (PARTITION BY ResourceID)          AS DeviceMedian,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY BootSeconds) OVER (PARTITION BY Model)               AS ModelMedian,
        PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY BootSeconds) OVER (PARTITION BY Model)               AS ModelP90,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY BootSeconds) OVER (PARTITION BY Model, BiosVersion)  AS BiosMedian,
        PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY BootSeconds) OVER (PARTITION BY Model, BiosVersion)  AS BiosP90,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY BootSeconds) OVER ()                                 AS FleetMedian
    FROM Boots
    WHERE BootSeconds IS NOT NULL
),
TimedByDevice AS (
    SELECT ResourceID, COUNT(*) AS TimedBoots, MAX(DeviceMedian) AS MedianBoot, MAX(BootSeconds) AS SlowestBoot,
        MAX(ModelMedian) AS ModelMedian, MAX(ModelP90) AS ModelP90, MAX(BiosMedian) AS BiosMedian,
        MAX(BiosP90) AS BiosP90, MAX(FleetMedian) AS FleetMedian
    FROM Timed
    GROUP BY ResourceID
),
BootsByDevice AS (
    SELECT ResourceID, COUNT(*) AS Boots, MAX(BootStart) AS LastBoot
    FROM Boots
    GROUP BY ResourceID
),
Crashes AS (
    SELECT c.ResourceID, c.Kind0 AS Kind, c.BugcheckCode0 AS BugcheckCode, c.DetectedAt0 AS DetectedAt
    FROM Devices d
    JOIN v_GS_LAYER8_CRASH c ON c.ResourceID = d.ResourceID
    WHERE c.DetectedAt0 &gt;= DATEADD(day, -@Days, GETUTCDATE())
),
CrashesByDevice AS (
    -- Blue screens, and stops with no blue screen: power lost, a hard reset, or the power button held down.
    SELECT ResourceID,
        SUM(CASE WHEN Kind = 'Bugcheck' THEN 1 ELSE 0 END)  AS BlueScreens,
        SUM(CASE WHEN Kind &lt;&gt; 'Bugcheck' THEN 1 ELSE 0 END) AS PowerLosses,
        MAX(DetectedAt) AS LastCrash
    FROM Crashes
    GROUP BY ResourceID
),
TopCode AS (
    -- Each device's most frequent blue screen code.
    SELECT ResourceID, BugcheckCode,
        ROW_NUMBER() OVER (PARTITION BY ResourceID ORDER BY COUNT(*) DESC, MAX(DetectedAt) DESC) AS Rank
    FROM Crashes
    WHERE Kind = 'Bugcheck' AND BugcheckCode IS NOT NULL
    GROUP BY ResourceID, BugcheckCode
),
Reported AS (
    -- When the site last got the device's boot data: from hardware inventory, after the collector ran.
    SELECT ResourceID, MAX(TimeStamp) AS BootDataFrom
    FROM v_GS_LAYER8_BOOT
    GROUP BY ResourceID
)
SELECT
    d.Device,
    d.Manufacturer,
    d.Model,
    ISNULL(d.BiosVersion, 'Unknown') AS BiosVersion,
    d.Windows,
    CASE WHEN r.ResourceID IS NULL THEN 'No boot data' ELSE 'Reporting' END AS DataStatus,
    ISNULL(bd.Boots, 0) AS Boots,
    ISNULL(td.TimedBoots, 0) AS TimedBoots,
    CAST(td.MedianBoot AS decimal(9, 1)) AS MedianBoot,
    CAST(td.SlowestBoot AS decimal(9, 1)) AS SlowestBoot,
    -- The collector's times are UTC; these show them in the site database server's time zone.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), bd.LastBoot) AS LastBoot,
    ISNULL(cd.BlueScreens, 0) AS BlueScreens,
    ISNULL(cd.PowerLosses, 0) AS PowerLosses,
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), cd.LastCrash) AS LastCrash,
    tc.BugcheckCode AS TopBugcheck,
    CAST(td.ModelMedian AS decimal(9, 1)) AS ModelMedian,
    CAST(td.ModelP90 AS decimal(9, 1)) AS ModelP90,
    CAST(td.BiosMedian AS decimal(9, 1)) AS BiosMedian,
    CAST(td.BiosP90 AS decimal(9, 1)) AS BiosP90,
    CAST(td.FleetMedian AS decimal(9, 1)) AS FleetMedian,
    r.BootDataFrom
FROM Devices d
LEFT JOIN Reported r         ON r.ResourceID = d.ResourceID
LEFT JOIN BootsByDevice bd   ON bd.ResourceID = d.ResourceID
LEFT JOIN TimedByDevice td   ON td.ResourceID = d.ResourceID
LEFT JOIN CrashesByDevice cd ON cd.ResourceID = d.ResourceID
LEFT JOIN TopCode tc         ON tc.ResourceID = d.ResourceID AND tc.Rank = 1
ORDER BY d.Model, d.BiosVersion, d.Device;
</CommandText><Timeout>600</Timeout></Query>
  <Fields><Field Name="Device"><DataField>Device</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Manufacturer"><DataField>Manufacturer</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Model"><DataField>Model</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BiosVersion"><DataField>BiosVersion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Windows"><DataField>Windows</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DataStatus"><DataField>DataStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Boots"><DataField>Boots</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TimedBoots"><DataField>TimedBoots</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="MedianBoot"><DataField>MedianBoot</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="SlowestBoot"><DataField>SlowestBoot</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="LastBoot"><DataField>LastBoot</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="BlueScreens"><DataField>BlueScreens</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="PowerLosses"><DataField>PowerLosses</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="LastCrash"><DataField>LastCrash</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="TopBugcheck"><DataField>TopBugcheck</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ModelMedian"><DataField>ModelMedian</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="ModelP90"><DataField>ModelP90</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="BiosMedian"><DataField>BiosMedian</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="BiosP90"><DataField>BiosP90</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="FleetMedian"><DataField>FleetMedian</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="BootDataFrom"><DataField>BootDataFrom</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields>
</DataSet>
<DataSet Name="Crashes">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters><QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter><QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter><QueryParameter Name="@Days"><Value>=Parameters!Days.Value</Value></QueryParameter></QueryParameters>
    <CommandText>-- Layer8 Boot times and crashes, the crash list: every unexpected stop in the period on a device in the collection,
-- newest first, with the blue screen code and its name when it was a blue screen.
--
-- Parameters
--   @UserSIDs      The reader's, so the report shows only what their ConfigMgr security scopes allow. The report
--                  fills it in; 'disabled' skips the check (for testing outside SSRS).
--   @CollectionID  The collection to report on, e.g. SMS00001 (All Systems).
--   @Days          How far back to count boots and crashes. 30 by default, which is as far back as the collector
--                  keeps them unless it runs with -Days.
--
-- Needs the Layer8 boot and crash collector (collector\Layer8-BootAndCrash.ps1) running on the devices, and its
-- classes Layer8_Boot and Layer8_Crash in hardware inventory. Their views are read directly: the device list
-- above them already limits the rows to devices the reader may see.

WITH Devices AS (
    -- The collection's devices with a client, as Fleet by model finds them, and the names it gives their models.
    SELECT
        sys.ResourceID,
        sys.Name0 AS Device,
        CASE
            WHEN cs.Manufacturer0 LIKE 'LENOVO%'                                 THEN 'Lenovo'
            WHEN cs.Manufacturer0 LIKE 'Dell%'                                   THEN 'Dell'
            WHEN cs.Manufacturer0 LIKE 'HP%' OR cs.Manufacturer0 LIKE 'Hewlett%' THEN 'HP'
            WHEN cs.Manufacturer0 LIKE 'Microsoft%'                              THEN 'Microsoft'
            WHEN cs.Manufacturer0 LIKE 'VMware%'                                 THEN 'VMware'
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Manufacturer0)), ''), 'Unknown')
        END AS Manufacturer,
        -- Lenovo's Model is a machine type code (21C5...); the name people know ("ThinkPad L14 Gen 3") is the
        -- system product's Version. Everyone else puts the name in Model.
        CASE
            WHEN cs.Manufacturer0 LIKE 'LENOVO%' AND NULLIF(LTRIM(RTRIM(csp.Version0)), '') IS NOT NULL
                 AND csp.Version0 NOT LIKE 'Lenovo' THEN LTRIM(RTRIM(csp.Version0))
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Model0)), ''), 'Unknown')
        END AS Model,
        bios.SMBIOSBIOSVersion0 AS BiosVersion,
        -- Windows by name and release, not just the build number.
        CASE
            WHEN os.Caption0 LIKE '%Server%' THEN REPLACE(os.Caption0, 'Microsoft ', '')
            WHEN os.BuildNumber0 = '26300' THEN 'Windows 11 26H2'
            WHEN os.BuildNumber0 = '26200' THEN 'Windows 11 25H2'
            WHEN os.BuildNumber0 = '26100' THEN 'Windows 11 24H2'
            WHEN os.BuildNumber0 = '22631' THEN 'Windows 11 23H2'
            WHEN os.BuildNumber0 = '22621' THEN 'Windows 11 22H2'
            WHEN os.BuildNumber0 = '22000' THEN 'Windows 11 21H2'
            WHEN os.BuildNumber0 = '19045' THEN 'Windows 10 22H2'
            WHEN os.BuildNumber0 = '19044' THEN 'Windows 10 21H2'
            WHEN os.BuildNumber0 IS NULL   THEN 'Unknown'
            WHEN TRY_CAST(os.BuildNumber0 AS int) &gt;= 22000 THEN 'Windows 11 (build ' + os.BuildNumber0 + ')'
            ELSE 'Windows 10 (build ' + os.BuildNumber0 + ')'
        END AS Windows,
        os.BuildNumber0 AS Build
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM(@UserSIDs) cs           ON cs.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM_PRODUCT(@UserSIDs) csp  ON csp.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_PC_BIOS(@UserSIDs) bios                 ON bios.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_OPERATING_SYSTEM(@UserSIDs) os          ON os.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
)
SELECT
    d.Device,
    d.Model,
    ISNULL(d.BiosVersion, 'Unknown') AS BiosVersion,
    -- The collector's times are UTC; this shows them in the site database server's time zone.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), c.DetectedAt0) AS DetectedAt,
    CASE WHEN c.Kind0 = 'Bugcheck' THEN 'Blue screen' ELSE c.Kind0 END AS Kind,
    c.BugcheckCode0 AS BugcheckCode,
    -- The names of the stop codes seen most often on desktops and laptops; others show the code alone.
    CASE c.BugcheckCode0
        WHEN '0x0000000A' THEN 'IRQL_NOT_LESS_OR_EQUAL'
        WHEN '0x00000019' THEN 'BAD_POOL_HEADER'
        WHEN '0x0000001A' THEN 'MEMORY_MANAGEMENT'
        WHEN '0x0000001E' THEN 'KMODE_EXCEPTION_NOT_HANDLED'
        WHEN '0x0000003B' THEN 'SYSTEM_SERVICE_EXCEPTION'
        WHEN '0x00000050' THEN 'PAGE_FAULT_IN_NONPAGED_AREA'
        WHEN '0x0000007A' THEN 'KERNEL_DATA_INPAGE_ERROR'
        WHEN '0x0000007E' THEN 'SYSTEM_THREAD_EXCEPTION_NOT_HANDLED'
        WHEN '0x0000009C' THEN 'MACHINE_CHECK_EXCEPTION'
        WHEN '0x0000009F' THEN 'DRIVER_POWER_STATE_FAILURE'
        WHEN '0x000000C2' THEN 'BAD_POOL_CALLER'
        WHEN '0x000000D1' THEN 'DRIVER_IRQL_NOT_LESS_OR_EQUAL'
        WHEN '0x000000E2' THEN 'MANUALLY_INITIATED_CRASH'
        WHEN '0x000000ED' THEN 'UNMOUNTABLE_BOOT_VOLUME'
        WHEN '0x000000EF' THEN 'CRITICAL_PROCESS_DIED'
        WHEN '0x000000F4' THEN 'CRITICAL_OBJECT_TERMINATION'
        WHEN '0x00000101' THEN 'CLOCK_WATCHDOG_TIMEOUT'
        WHEN '0x00000116' THEN 'VIDEO_TDR_FAILURE'
        WHEN '0x00000119' THEN 'VIDEO_SCHEDULER_INTERNAL_ERROR'
        WHEN '0x00000124' THEN 'WHEA_UNCORRECTABLE_ERROR'
        WHEN '0x00000133' THEN 'DPC_WATCHDOG_VIOLATION'
        WHEN '0x00000139' THEN 'KERNEL_SECURITY_CHECK_FAILURE'
        WHEN '0x00000154' THEN 'UNEXPECTED_STORE_EXCEPTION'
        WHEN '0x0000015F' THEN 'CONNECTED_STANDBY_WATCHDOG_TIMEOUT_LIVEDUMP'
    END AS BugcheckName,
    c.BugcheckParameters0 AS BugcheckParameters,
    c.DumpFile0 AS DumpFile
FROM Devices d
JOIN v_GS_LAYER8_CRASH c ON c.ResourceID = d.ResourceID
WHERE c.DetectedAt0 &gt;= DATEADD(day, -@Days, GETUTCDATE())   -- the collector's times are UTC
ORDER BY c.DetectedAt0 DESC, d.Device;
</CommandText><Timeout>600</Timeout></Query>
  <Fields><Field Name="Device"><DataField>Device</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Model"><DataField>Model</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BiosVersion"><DataField>BiosVersion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DetectedAt"><DataField>DetectedAt</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Kind"><DataField>Kind</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BugcheckCode"><DataField>BugcheckCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BugcheckName"><DataField>BugcheckName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BugcheckParameters"><DataField>BugcheckParameters</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DumpFile"><DataField>DumpFile</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
</DataSet></DataSets>
<Body><ReportItems><Textbox Name="Title"><Top>0in</Top><Left>0in</Left><Height>0.38in</Height><Width>6in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Boot times and crashes</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="Subtitle"><Top>0.38in</Top><Left>0in</Left><Height>0.25in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!CollectionID.Label &amp; "  ·  " &amp; CountRows("Devices") &amp; " devices  ·  the last " &amp; Parameters!Days.Value &amp; " days  ·  run " &amp; Format(Globals!ExecutionTime, "g")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="TileSendingbootdata"><Top>0.75in</Top><Left>0.0in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!DataStatus.Value = "Reporting", 1, 0), "Devices") &amp; " of " &amp; CountRows("Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Sending boot data</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileMedianboot"><Top>0.75in</Top><Left>2.146in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Max(Fields!FleetMedian.Value, "Devices")), "-", IIf(Max(Fields!FleetMedian.Value, "Devices") &gt;= 120, Format(Max(Fields!FleetMedian.Value, "Devices") / 60, "0.0") &amp; " min", Format(Max(Fields!FleetMedian.Value, "Devices"), "0") &amp; " s"))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Median boot</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileSlowestboot"><Top>0.75in</Top><Left>4.292in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Max(Fields!SlowestBoot.Value, "Devices")), "-", IIf(Max(Fields!SlowestBoot.Value, "Devices") &gt;= 120, Format(Max(Fields!SlowestBoot.Value, "Devices") / 60, "0.0") &amp; " min", Format(Max(Fields!SlowestBoot.Value, "Devices"), "0") &amp; " s"))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Slowest boot</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileBluescreens"><Top>0.75in</Top><Left>6.438in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!BlueScreens.Value, "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Blue screens</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TilePowerlosses"><Top>0.75in</Top><Left>8.584in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!PowerLosses.Value, "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Power losses</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#ec835a</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="Note"><Top>1.45in</Top><Left>0in</Left><Height>0.3in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Boot time is Windows' own measure, from power on until the desktop is ready and startup has settled, for the boots Windows timed. Power losses: the device stopped without a blue screen (power cut, a hard reset, or the power button held). Times are the site's local time."</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Chart Name="BootByModel">
