me="FamilyDevices"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows()</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder><BackgroundColor>#f9f9f7</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="FamilyMedianAge"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(Min(Fields!GenMedianAge.Value) = Max(Fields!GenMedianAge.Value), Format(Min(Fields!GenMedianAge.Value), "0.0"), Format(Min(Fields!GenMedianAge.Value), "0.0") &amp; "-" &amp; Format(Max(Fields!GenMedianAge.Value), "0.0"))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><ToolTip>Years since first seen: the range of its generations' medians</ToolTip><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder><BackgroundColor>#f9f9f7</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="FamilyAtStart"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!AtStart.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>=IIf((Sum(Fields!AtStart.Value)) = 0, "#c3c2b7", "#0b0b0b")</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder><BackgroundColor>#f9f9f7</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="FamilyGoneQuiet"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Departed.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>=IIf((Sum(Fields!Departed.Value)) = 0, "#c3c2b7", "#0b0b0b")</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder><BackgroundColor>#f9f9f7</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="FamilyPerYear"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(Sum(Fields!AtStart.Value) = 0 Or Parameters!WindowDays.Value &lt;= Parameters!IdleDays.Value, "-", Sum(Fields!Departed.Value) / Sum(Fields!AtStart.Value) * 365 / (Parameters!WindowDays.Value - Parameters!IdleDays.Value))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSi