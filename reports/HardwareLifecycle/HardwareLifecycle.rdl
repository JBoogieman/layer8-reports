<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
<Description>Devices in a collection grouped by model family and generation: how old they are, how many went quiet over the last few months and how fast that is per year, and what likely replaced them. From layer8-reports.</Description>
<Author>layer8-reports</Author>
<AutoRefresh>0</AutoRefresh>
<DataSources><DataSource Name="AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_"><DataSourceReference>{5C6358F2-4BB6-4a1b-A16E-8D96795D8602}</DataSourceReference></DataSource></DataSources>
<DataSets>
<DataSet Name="AdminID">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters><QueryParameter Name="@UserTokenSIDs"><Value>=Parameters!UserTokenSIDs.Value</Value></QueryParameter></QueryParameters>
    <CommandText>select dbo.fn_rbac_GetAdminIDsfromUserSIDs(@UserTokenSIDs) as UserSIDs</CommandText></Query>
  <Fields><Field Name="UserSIDs"><DataField>UserSIDs</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
</DataSet>
<DataSet Name="Collections">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters><QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter></QueryParameters>
    <CommandText>SELECT CollectionID, Name FROM fn_rbac_Collection(@UserSIDs) WHERE CollectionType = 2 ORDER BY Name</CommandText></Query>
  <Fields>
    <Field Name="CollectionID"><DataField>CollectionID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
    <Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
    <Field Name="LocCollectionName"><Value>=SrsResources.Localization.GetDBString(Fields!Name.Value, User!Language, "SMS_Collection-Name")</Value></Field>
  </Fields>
</DataSet>
<DataSet Name="Devices">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
      <QueryParameter Name="@IdleDays"><Value>=Parameters!IdleDays.Value</Value></QueryParameter>
      <QueryParameter Name="@WindowDays"><Value>=Parameters!WindowDays.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 Hardware lifecycle: one row per device in a collection, with its age and where it is in its life, and its
-- generation's figures: how many left over the last few months, how many arrived, and how old they are. The report
-- groups the rows by model family and generation.
--
-- Parameters
--   @UserSIDs      The reader's, so the report shows only what their ConfigMgr security scopes allow. The report
--                  fills it in; 'disabled' skips the check (for testing outside SSRS).
--   @CollectionID  The collection to report on, e.g. SMS00001 (All Systems).
--   @IdleDays      How long without contact before a device counts as gone quiet. 30 by default.
--   @WindowDays    How far back to look for devices that left. Set it to the site's Delete Aged Discovery Data
--                  setting (90 by default): a device quiet for longer than that may already be deleted, and a
--                  deleted device can't be counted.
--
-- ConfigMgr deletes devices that stop checking in, so it can't say how many of a generation died over years. What it
-- can say is how many went quiet over the last few months, out of how many there were. That is the rate here.
--
-- A likely replacement: a device that was here when the window began and has gone quiet, and a device that arrived in
-- the window and is still active, with the same top console user. Each old device gets at most one, the new device
-- first seen closest to when the old one went quiet, and each new device replaces at most one. Someone with two laptops,
-- or a shared device, can be paired wrongly, so the report calls these likely replacements.
--
-- Group figures are worked out here because the report server has no median. Every device row carries its
-- generation's figures; the report shows them once a group.

WITH Console AS (
    SELECT ResourceID, MAX(LastConsoleUse0) AS LastConsoleUse
    FROM fn_rbac_GS_SYSTEM_CONSOLE_USER(@UserSIDs)
    GROUP BY ResourceID
),
-- A serial number names the hardware; a ConfigMgr record names one life of it in the site. A rebuild can give the same
-- laptop a new record (the old one turns obsolete until site maintenance deletes it), so the earliest record with this
-- serial is a better "first seen" than the current record's.
SerialRecords AS (
    SELECT
        ISNULL(NULLIF(LTRIM(RTRIM(p.IdentifyingNumber0)), ''), b.SerialNumber0) AS Serial,
        r.Creation_Date0
    FROM fn_rbac_GS_PC_BIOS(@UserSIDs) b
    JOIN fn_rbac_R_System(@UserSIDs) r                          ON r.ResourceID = b.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM_PRODUCT(@UserSIDs) p   ON p.ResourceID = b.ResourceID
),
SerialHistory AS (
    SELECT Serial, MIN(Creation_Date0) AS FirstSeenEver, COUNT(*) AS Records
    FROM SerialRecords
    -- Placeholder serials some vendors and hypervisors ship would lump unrelated devices together.
    WHERE Serial IS NOT NULL
      AND Serial NOT IN ('0', 'None', 'Default string', 'To be filled by O.E.M.', 'System Serial Number', 'Not Specified')
    GROUP BY Serial
),
Base AS (
    SELECT
        sys.ResourceID,
        sys.Name0 AS Device,
        CASE
            WHEN cs.Manufacturer0 LIKE 'LENOVO%'                                 THEN 'Lenovo'
            WHEN cs.Manufacturer0 LIKE 'Dell%'                                   THEN 'Dell'
            WHEN cs.Manufacturer0 LIKE 'HP%' OR cs.Manufacturer0 LIKE 'Hewlett%' THEN 'HP'
            WHEN cs.Manufacturer0 LIKE 'Microsoft%'                              THEN 'Microsoft'
            WHEN cs.Manufacturer0 LIKE 'VMware%'                                 THEN 'VMware'
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Manufacturer0)), ''), 'Unknown')
        END AS Manufacturer,
        CASE
            WHEN cs.Manufacturer0 LIKE 'LENOVO%' AND NULLIF(LTRIM(RTRIM(csp.Version0)), '') IS NOT NULL
                 AND csp.Version0 NOT LIKE 'Lenovo' THEN LTRIM(RTRIM(csp.Version0))
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Model0)), ''), 'Unknown')
        END AS Model,
        ISNULL(NULLIF(LTRIM(RTRIM(csp.IdentifyingNumber0)), ''), bios.SerialNumber0) AS Serial,
        sys.Creation_Date0 AS FirstSeen,     -- this record's creation: resets if a rebuild makes a new record
        os.InstallDate0 AS OSInstalled,      -- resets at every reimage
        bios.SMBIOSBIOSVersion0 AS BiosVersion,
        bios.ReleaseDate0 AS BiosDate,       -- the installed firmware's date: moves with every BIOS update
        ch.LastActiveTime AS LastActive,     -- UTC, so it's compared with GETUTCDATE()
        con.LastConsoleUse AS LastSignIn,
        NULLIF(LTRIM(RTRIM(cu.TopConsoleUser0)), '') AS TopUser,
        CASE WHEN cu.ResourceID IS NULL THEN 0 ELSE 1 END AS HasConsoleUsage
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM(@UserSIDs) cs           ON cs.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM_PRODUCT(@UserSIDs) csp  ON csp.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_PC_BIOS(@UserSIDs) bios                 ON bios.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_OPERATING_SYSTEM(@UserSIDs) os          ON os.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_SYSTEM_CONSOLE_USAGE(@UserSIDs) cu      ON cu.ResourceID = sys.ResourceID
    LEFT JOIN Console con                                        ON con.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_CH_ClientSummary(@UserSIDs) ch             ON ch.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Devices AS (
    SELECT
        b.*,
        -- Family and generation exactly as Fleet by model splits them, so the two reports agree.
        CASE
            WHEN b.Manufacturer = 'Lenovo' AND PATINDEX('% Gen [0-9]%', b.Model) &gt; 0 THEN LEFT(b.Model, PATINDEX('% Gen [0-9]%', b.Model) - 1)
            WHEN b.Manufacturer = 'HP' AND PATINDEX('% G[0-9]%', b.Model) &gt; 0       THEN LEFT(b.Model, PATINDEX('% G[0-9]%', b.Model) - 1)
            ELSE b.Model
        END AS Family,
        CASE
            WHEN b.Manufacturer = 'Lenovo' AND PATINDEX('% Gen [0-9]%', b.Model) &gt; 0
                THEN LTRIM(SUBSTRING(b.Model, PATINDEX('% Gen [0-9]%', b.Model) + 1, 6))
            WHEN b.Manufacturer = 'HP' AND PATINDEX('% G[0-9]%', b.Model) &gt; 0
                THEN LEFT(LTRIM(SUBSTRING(b.Model, PATINDEX('% G[0-9]%', b.Model) + 1, 4)) + ' ', CHARINDEX(' ', LTRIM(SUBSTRING(b.Model, PATINDEX('% G[0-9]%', b.Model) + 1, 4)) + ' ') - 1)
            ELSE ''
        END AS Generation,
        sh.Records,
        ISNULL(sh.FirstSeenEver, b.FirstSeen) AS FirstSeenEver,
        -- Active: in contact recently. Gone quiet: stopped within the window, so it still counts. Long gone: stopped
        -- before the window; the site still has it (usually because discovery keeps finding it in AD), but it left
        -- too long ago to count fairly against the others.
        CASE
            WHEN b.LastActive IS NULL                                     THEN 'No data'
            WHEN b.LastActive &gt;= DATEADD(day, -@IdleDays, GETUTCDATE())   THEN 'Active'
            WHEN b.LastActive &gt;= DATEADD(day, -@WindowDays, GETUTCDATE()) THEN 'Gone quiet'
            ELSE 'Long gone'
        END AS Lifecycle
    FROM Base b
    LEFT JOIN SerialHistory sh ON sh.Serial = b.Serial
),
Flagged AS (
    SELECT
        d.*,
        -- There at the start of the window: first seen before it, and still in contact when it began.
        CASE WHEN d.FirstSeenEver &lt; DATEADD(day, -@WindowDays, GETDATE()) AND d.Lifecycle IN ('Active', 'Gone quiet')
             THEN 1 ELSE 0 END AS AtStart,
        CASE WHEN d.FirstSeenEver &gt;= DATEADD(day, -@WindowDays, GETDATE()) THEN 1 ELSE 0 END AS Arrived,
        CASE WHEN d.Records &gt; 1 THEN 1 ELSE 0 END AS Rebuilt,
        CAST(DATEDIFF(day, d.FirstSeenEver, GETDATE()) / 365.25 AS decimal(4, 1)) AS AgeYears
    FROM Devices d
),
Counted AS (
    SELECT
        f.*,
        -- Left during the window: there at its start, and has since gone quiet.
        CASE WHEN f.AtStart = 1 AND f.Lifecycle = 'Gone quiet' THEN 1 ELSE 0 END AS Departed
    FROM Flagged f
),
Candidates AS (
    SELECT
        o.ResourceID AS OldID,
        n.ResourceID AS NewID,
        n.Device, n.Model, n.Family, n.Generation,
        ROW_NUMBER() OVER (PARTITION BY o.ResourceID ORDER BY ABS(DATEDIFF(hour, n.FirstSeenEver, o.LastActive)), n.ResourceID) AS ForOld,
        ROW_NUMBER() OVER (PARTITION BY n.ResourceID ORDER BY ABS(DATEDIFF(hour, n.FirstSeenEver, o.LastActive)), o.ResourceID) AS ForNew
    FROM Counted o
    JOIN Counted n ON n.TopUser = o.TopUser AND n.ResourceID &lt;&gt; o.ResourceID
    -- Only devices that were here at the start. A loaner that came and went inside the window would otherwise be the
    -- closest match for the new device and take it, and the laptop it stood in for would show as not replaced.
    WHERE o.Departed = 1
      AND n.Arrived = 1 AND n.Lifecycle = 'Active'
),
Pairs AS (
    SELECT OldID, Device, Model, Family, Generation FROM Candidates WHERE ForOld = 1 AND ForNew = 1
)
SELECT
    c.Device,
    c.Manufacturer,
    c.Family,
    c.Generation,
    c.Model,
    c.Serial,
    c.Records,
    c.FirstSeenEver,
    c.FirstSeen,
    c.OSInstalled,
    c.BiosVersion,
    c.BiosDate,
    c.AgeYears,
    CASE
        WHEN c.LastActive IS NULL OR c.LastActive &lt; DATEADD(day, -@IdleDays, GETUTCDATE()) THEN 'Not seen'
        WHEN c.LastSignIn &gt;= DATEADD(day, -@IdleDays, GETDATE())                      THEN 'In use'
        WHEN c.HasConsoleUsage = 0                                                    THEN 'Unknown'
        ELSE 'Unused'
    END AS Status,
    c.Lifecycle,
    c.LastActive,
    c.TopUser,
    p.Device AS ReplacedBy,
    p.Model AS ReplacedByModel,
    p.Family AS ReplacedByFamily,
    p.Generation AS ReplacedByGeneration,
    c.AtStart,
    c.Departed,
    c.Arrived,
    c.Rebuilt,
    -- The generation's figures, on every one of its rows.
    COUNT(*) OVER (PARTITION BY c.Family, c.Generation)        AS GenDevices,
    SUM(c.AtStart) OVER (PARTITION BY c.Family, c.Generation)  AS GenAtStart,
    SUM(c.Departed) OVER (PARTITION BY c.Family, c.Generation) AS GenDeparted,
    SUM(c.Arrived) OVER (PARTITION BY c.Family, c.Generation)  AS GenArrived,
    SUM(c.Rebuilt) OVER (PARTITION BY c.Family, c.Generation)  AS GenRebuilt,
    SUM(CASE WHEN c.Departed = 1 AND p.OldID IS NOT NULL THEN 1 ELSE 0 END)
        OVER (PARTITION BY c.Family, c.Generation)             AS GenReplaced,
    CAST(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY c.AgeYears)
        OVER (PARTITION BY c.Family, c.Generation) AS decimal(4, 1)) AS GenMedianAge,
    -- The share that left. A device counts as left once it's been quiet @IdleDays, so the departures seen are the ones
    -- that went quiet between the window's start and @IdleDays ago: (@WindowDays - @IdleDays) days' worth. Per year
    -- scales that span to 365 days.
    CAST(100.0 * SUM(c.Departed) OVER (PARTITION BY c.Family, c.Generation)
        / NULLIF(SUM(c.AtStart) OVER (PARTITION BY c.Family, c.Generation), 0) AS decimal(5, 1)) AS GenDepartedPct,
    CAST(100.0 * SUM(c.Departed) OVER (PARTITION BY c.Family, c.Generation)
        / NULLIF(SUM(c.AtStart) OVER (PARTITION BY c.Family, c.Generation), 0)
        * 365.0 / NULLIF(@WindowDays - @IdleDays, 0) AS decimal(7, 1))                         AS GenDepartedPerYear
FROM Counted c
LEFT JOIN Pairs p ON p.OldID = c.ResourceID
ORDER BY c.Family, c.Generation, c.Device;
</CommandText>
    <Timeout>600</Timeout></Query>
  <Fields><Field Name="Device"><DataField>Device</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Manufacturer"><DataField>Manufacturer</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Family"><DataField>Family</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Generation"><DataField>Generation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Model"><DataField>Model</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Serial"><DataField>Serial</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Records"><DataField>Records</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="FirstSeenEver"><DataField>FirstSeenEver</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="FirstSeen"><DataField>FirstSeen</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="OSInstalled"><DataField>OSInstalled</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="BiosVersion"><DataField>BiosVersion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BiosDate"><DataField>BiosDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="AgeYears"><DataField>AgeYears</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Lifecycle"><DataField>Lifecycle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="LastActive"><DataField>LastActive</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="TopUser"><DataField>TopUser</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ReplacedBy"><DataField>ReplacedBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ReplacedByModel"><DataField>ReplacedByModel</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ReplacedByFamily"><DataField>ReplacedByFamily</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ReplacedByGeneration"><DataField>ReplacedByGeneration</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AtStart"><DataField>AtStart</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Departed"><DataField>Departed</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Arrived"><DataField>Arrived</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Rebuilt"><DataField>Rebuilt</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GenDevices"><DataField>GenDevices</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GenAtStart"><DataField>GenAtStart</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GenDeparted"><DataField>GenDeparted</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GenArrived"><DataField>GenArrived</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GenRebuilt"><DataField>GenRebuilt</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GenReplaced"><DataField>GenReplaced</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GenMedianAge"><DataField>GenMedianAge</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="GenDepartedPct"><DataField>GenDepartedPct</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="GenDepartedPerYear"><DataField>GenDepartedPerYear</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields>
</DataSet>
</DataSets>
<Body><ReportItems><Textbox Name="Title"><Top>0in</Top><Left>0in</Left><Height>0.38in</Height><Width>6in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Hardware lifecycle</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="Subtitle"><Top>0.38in</Top><Left>0in</Left><Height>0.25in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!CollectionID.Label &amp; "  ·  " &amp; CountRows("Devices") &amp; " devices  ·  gone quiet means no contact for " &amp; Parameters!IdleDays.Value &amp; " days, counted over the last " &amp; Parameters!WindowDays.Value &amp; " days  ·  run " &amp; Format(Globals!ExecutionTime, "g")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="TileDevices"><Top>0.75in</Top><Left>0.000in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows("Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Devices</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileGoneQuiet"><Top>0.75in</Top><Left>2.146in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Departed.Value, "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Gone quiet in the window</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TilePerYear"><Top>0.75in</Top><Left>4.292in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(Sum(Fields!AtStart.Value, "Devices") = 0 Or Parameters!WindowDays.Value &lt;= Parameters!IdleDays.Value, "-", Sum(Fields!Departed.Value, "Devices") / Sum(Fields!AtStart.Value, "Devices") * 365 / (Parameters!WindowDays.Value - Parameters!IdleDays.Value))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>0%</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Gone quiet per year</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileReplaced"><Top>0.75in</Top><Left>6.438in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!Departed.Value = 1 And Not IsNothing(Fields!ReplacedBy.Value), 1, 0), "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Of those, likely replaced</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#fab219</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileArrived"><Top>0.75in</Top><Left>8.584in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Arrived.Value, "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Arrived in the window</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#0ca30c</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="LifecycleNote"><Top>1.45in</Top><Left>0in</Left><Height>0.3in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Gone quiet</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=": here when the window began, and no contact with the site for " &amp; Parameters!IdleDays.Value &amp; " days (dead, retired, or in a drawer).   "</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Per year</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=IIf(Parameters!WindowDays.Value &gt; Parameters!IdleDays.Value, ": the share of those here at the start that went quiet, scaled up to a year from the " &amp; (Parameters!WindowDays.Value - Parameters!IdleDays.Value) &amp; " days it measures (the window, less the " &amp; Parameters!IdleDays.Value &amp; " days a device must be quiet to count).   ", ": needs a window longer than " &amp; Parameters!IdleDays.Value &amp; " days.   ")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Likely replaced</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=": its top user got a device in the window that's still active, paired one to one by the closest dates.   "</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Red</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=": a generation going quiet at least twice as fast as the whole collection, with at least 10 there at the start.   "</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Age</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=": years since the site first saw the device, not since it was bought.   "</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Long gone</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=": quiet since before the window began, so not counted.   "</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Window</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=": set it to the site's Delete Aged Discovery Data setting, because devices quiet for longer may already be deleted."</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Tablix Name="Generations"><TablixBody><TablixColumns><TablixColumn><Width>2.2in</Width></TablixColumn><TablixColumn><Width>0.5in</Width></TablixColumn><TablixColumn><Width>0.6in</Width></TablixColumn><TablixColumn><Width>0.5in</Width></TablixColumn><TablixColumn><Width>0.55in</Width></TablixColumn><TablixColumn><Width>0.6in</Width></TablixColumn><TablixColumn><Width>0.6in</Width></TablixColumn><TablixColumn><Width>0.5in</Width></TablixColumn><TablixColumn><Width>0.5in</Width></TablixColumn><TablixColumn><Width>0.7in</Width></TablixColumn><TablixColumn><Width>0.8in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.25in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.3in</Height><TablixCells><TablixCell><CellContents><Textbox Name="HeadFamilyGenerationDevice"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Family / generation / device</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#52514e</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="HeadDevices"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Devices</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#52514e</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="HeadMedianAge"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Median age</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#52514e</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="HeadAtStart"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>At start</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</F