  <TablixCell><CellContents><Textbox Name="VerVersion"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!BiosVersion.Value)), &quot;No data&quot;, First(Fields!BiosVersion.Value))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>=IIf(Max(Fields!IsNewest.Value) = 1, &quot;SemiBold&quot;, &quot;Normal&quot;)</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
