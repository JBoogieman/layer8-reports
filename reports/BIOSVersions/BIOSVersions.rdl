<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
<Description>The BIOS versions in a collection by model family and generation: how many versions each model runs, how old the installed firmware is, and the devices behind the newest seen on their model. From layer8-reports.</Description>
<Author>layer8-reports</Author>
<AutoRefresh>0</AutoRefresh>
<DataSources><DataSource Name="AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_"><DataSourceReference>{5C6358F2-4BB6-4a1b-A16E-8D96795D8602}</DataSourceReference></DataSource></DataSources>
<DataSets>
<DataSet Name="AdminID">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters><QueryParameter Name="@UserTokenSIDs"><Value>=Parameters!UserTokenSIDs.Value</Value></QueryParameter></QueryParameters>
    <CommandText>select dbo.fn_rbac_GetAdminIDsfromUserSIDs(@UserTokenSIDs) as UserSIDs</CommandText></Query>
  <Fields><Field Name="UserSIDs"><DataField>UserSIDs</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
</DataSet>
<DataSet Name="Collections">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters><QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter></QueryParameters>
    <CommandText>SELECT CollectionID, Name FROM fn_rbac_Collection(@UserSIDs) WHERE CollectionType = 2 ORDER BY Name</CommandText></Query>
  <Fields>
    <Field Name="CollectionID"><DataField>CollectionID</DataField><rd:TypeName>System.String</rd:TypeName></Field>
    <Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
    <Field Name="LocCollectionName"><Value>=SrsResources.Localization.GetDBString(Fields!Name.Value, User!Language, "SMS_Collection-Name")</Value></Field>
  </Fields>
</DataSet>
<DataSet Name="Devices">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 BIOS versions: one row per device in a collection, with its BIOS version and when that version was released,
-- the newest seen on its exact model, and whether it&apos;s behind. The report groups the rows by model family and
-- generation, and lists each model&apos;s versions.
--
-- Parameters
--   @UserSIDs      The reader&apos;s, so the report shows only what their ConfigMgr security scopes allow. The report
--                  fills it in; &apos;disabled&apos; skips the check (for testing outside SSRS).
--   @CollectionID  The collection to report on, e.g. SMS00001 (All Systems).
--
-- Newest means the newest seen in the site on that exact model, by release date: vendors&apos; version strings don&apos;t
-- compare, and no vendor catalog is used. A model whose every device is behind the vendor&apos;s latest still shows as on
-- the newest. The release date is the installed firmware&apos;s, so it moves with every BIOS update; it says nothing about
-- when the device was bought.

WITH Base AS (
    SELECT
        sys.ResourceID,
        sys.Name0 AS Device,
        CASE
            WHEN cs.Manufacturer0 LIKE &apos;LENOVO%&apos;                                 THEN &apos;Lenovo&apos;
            WHEN cs.Manufacturer0 LIKE &apos;Dell%&apos;                                   THEN &apos;Dell&apos;
            WHEN cs.Manufacturer0 LIKE &apos;HP%&apos; OR cs.Manufacturer0 LIKE &apos;Hewlett%&apos; THEN &apos;HP&apos;
            WHEN cs.Manufacturer0 LIKE &apos;Microsoft%&apos;                              THEN &apos;Microsoft&apos;
            WHEN cs.Manufacturer0 LIKE &apos;VMware%&apos;                                 THEN &apos;VMware&apos;
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Manufacturer0)), &apos;&apos;), &apos;Unknown&apos;)
        END AS Manufacturer,
        CASE
            WHEN cs.Manufacturer0 LIKE &apos;LENOVO%&apos; AND NULLIF(LTRIM(RTRIM(csp.Version0)), &apos;&apos;) IS NOT NULL
                 AND csp.Version0 NOT LIKE &apos;Lenovo&apos; THEN LTRIM(RTRIM(csp.Version0))
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Model0)), &apos;&apos;), &apos;Unknown&apos;)
        END AS Model,
        NULLIF(LTRIM(RTRIM(bios.SMBIOSBIOSVersion0)), &apos;&apos;) AS BiosVersion,
        CAST(bios.ReleaseDate0 AS date) AS BiosDate,
        ch.LastActiveTime AS LastActiveUtc            -- UTC
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM(@UserSIDs) cs           ON cs.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM_PRODUCT(@UserSIDs) csp  ON csp.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_PC_BIOS(@UserSIDs) bios                 ON bios.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_CH_ClientSummary(@UserSIDs) ch             ON ch.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Devices AS (
    SELECT
        b.*,
        -- Family and generation exactly as Fleet by model splits them, so the reports agree.
        CASE
            WHEN b.Manufacturer = &apos;Lenovo&apos; AND PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) &gt; 0 THEN LEFT(b.Model, PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) - 1)
            WHEN b.Manufacturer = &apos;HP&apos; AND PATINDEX(&apos;% G[0-9]%&apos;, b.Model) &gt; 0       THEN LEFT(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) - 1)
            ELSE b.Model
        END AS Family,
        CASE
            WHEN b.Manufacturer = &apos;Lenovo&apos; AND PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) &gt; 0
                THEN LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) + 1, 6))
            WHEN b.Manufacturer = &apos;HP&apos; AND PATINDEX(&apos;% G[0-9]%&apos;, b.Model) &gt; 0
                THEN LEFT(LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) + 1, 4)) + &apos; &apos;, CHARINDEX(&apos; &apos;, LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) + 1, 4)) + &apos; &apos;) - 1)
            ELSE &apos;&apos;
        END AS Generation,
        -- The newest BIOS seen on this exact model, and its version.
        MAX(b.BiosDate) OVER (PARTITION BY b.Model) AS NewestDate,
        FIRST_VALUE(b.BiosVersion) OVER (PARTITION BY b.Model ORDER BY CASE WHEN b.BiosDate IS NULL THEN 1 ELSE 0 END, b.BiosDate DESC, b.BiosVersion DESC
                                         ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS NewestVersion,
        CAST(DATEDIFF(day, b.BiosDate, GETDATE()) / 365.25 AS decimal(4, 1)) AS AgeYears
    FROM Base b
)
SELECT
    d.Device,
    d.Manufacturer,
    d.Family,
    d.Generation,
    d.Model,
    d.BiosVersion,
    d.BiosDate,
    d.AgeYears,
    d.NewestVersion,
    d.NewestDate,
    CASE WHEN d.BiosDate IS NULL THEN &apos;No data&apos; WHEN d.BiosDate &lt; d.NewestDate THEN &apos;Behind&apos; ELSE &apos;Newest&apos; END AS Status,
    CASE WHEN d.BiosDate IS NOT NULL AND d.BiosDate = d.NewestDate THEN 1 ELSE 0 END AS IsNewest,
    CASE WHEN d.BiosDate &lt; d.NewestDate THEN 1 ELSE 0 END AS IsBehind,
    CASE WHEN d.BiosDate IS NULL THEN 1 ELSE 0 END AS IsNoData,
    -- Sorts a model&apos;s versions newest first: the model, then the release date counted down.
    d.Model + &apos;|&apos; + ISNULL(RIGHT(&apos;0000000&apos; + CAST(99999999 - CAST(CONVERT(char(8), d.BiosDate, 112) AS int) AS varchar(8)), 8), &apos;99999999&apos;) AS VersionSortKey,
    -- UTC in the site; shown in the site database server&apos;s time zone, like the other reports&apos; times.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), d.LastActiveUtc) AS LastActive,
    -- Medians, because the report server has none: for the generation, the family, and the whole collection.
    CAST(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY d.AgeYears) OVER (PARTITION BY d.Family, d.Generation) AS decimal(4, 1)) AS GenMedianAge,
    CAST(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY d.AgeYears) OVER (PARTITION BY d.Family) AS decimal(4, 1)) AS FamilyMedianAge,
    CAST(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY d.AgeYears) OVER () AS decimal(4, 1)) AS AllMedianAge
FROM Devices d
ORDER BY d.Family, d.Generation, d.Device;
</CommandText>
    <Timeout>600</Timeout></Query>
  <Fields><Field Name="Device"><DataField>Device</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Manufacturer"><DataField>Manufacturer</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Family"><DataField>Family</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Generation"><DataField>Generation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Model"><DataField>Model</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BiosVersion"><DataField>BiosVersion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BiosDate"><DataField>BiosDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="AgeYears"><DataField>AgeYears</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="NewestVersion"><DataField>NewestVersion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="NewestDate"><DataField>NewestDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="IsNewest"><DataField>IsNewest</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsBehind"><DataField>IsBehind</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsNoData"><DataField>IsNoData</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="VersionSortKey"><DataField>VersionSortKey</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="LastActive"><DataField>LastActive</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="GenMedianAge"><DataField>GenMedianAge</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="FamilyMedianAge"><DataField>FamilyMedianAge</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="AllMedianAge"><DataField>AllMedianAge</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields>
</DataSet>
<DataSet Name="Freshness">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 data freshness: how current the hardware inventory behind a report is, for the report&apos;s page footer. Every
-- report runs this for its own collection, so the footer counts the same devices the report does.
--
-- Parameters
--   @UserSIDs      The reader&apos;s, so only devices their ConfigMgr security scopes allow are counted. The report fills
--                  it in; &apos;disabled&apos; skips the check (for testing outside SSRS).
--   @CollectionID  The report&apos;s collection.
--
-- One row: the devices, how many have never sent hardware inventory, the newest inventory, and the median age of the
-- devices&apos; latest inventory (half the devices sent theirs more recently than that). The median is worked out here
-- because the report server has none.

WITH Devices AS (
    SELECT ch.LastHW                                     -- the last hardware inventory, in UTC
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys                 ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_CH_ClientSummary(@UserSIDs) ch     ON ch.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Aged AS (
    SELECT LastHW,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY DATEDIFF(minute, LastHW, GETUTCDATE()) / 1440.0) OVER () AS MedianAgeDays
    FROM Devices
)
SELECT
    COUNT(*) AS Devices,
    ISNULL(SUM(CASE WHEN LastHW IS NULL THEN 1 ELSE 0 END), 0) AS NoInventory,
    -- Shown in the site database server&apos;s time zone, like the reports&apos; other times.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), MAX(LastHW)) AS NewestInventory,
    CAST(MAX(MedianAgeDays) AS decimal(9, 1)) AS MedianAgeDays
FROM Aged;
</CommandText></Query>
  <Fields>
    <Field Name="Devices"><DataField>Devices</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    <Field Name="NoInventory"><DataField>NoInventory</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    <Field Name="NewestInventory"><DataField>NewestInventory</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
    <Field Name="MedianAgeDays"><DataField>MedianAgeDays</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
  </Fields>
</DataSet>
</DataSets>
<Body><ReportItems><Textbox Name="Title"><Top>0in</Top><Left>0in</Left><Height>0.38in</Height><Width>6in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>BIOS versions</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="Subtitle"><Top>0.38in</Top><Left>0in</Left><Height>0.25in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!CollectionID.Label &amp; &quot;  ·  &quot; &amp; CountRows(&quot;Devices&quot;) &amp; &quot; devices on &quot; &amp; CountDistinct(Fields!Model.Value, &quot;Devices&quot;) &amp; &quot; models  ·  newest means the newest seen in the site on each model, by release date  ·  run &quot; &amp; Format(Globals!ExecutionTime, &quot;g&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="TileDevices"><Top>0.75in</Top><Left>0.000in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows(&quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Devices</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileNewest"><Top>0.75in</Top><Left>2.146in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsNewest.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>On the newest seen</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#0ca30c</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileBehind"><Top>0.75in</Top><Left>4.292in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsBehind.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Behind</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#fab219</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileAge"><Top>0.75in</Top><Left>6.438in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(First(Fields!AllMedianAge.Value, &quot;Devices&quot;), &quot;0.0&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Years since release, the median</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileNoData"><Top>0.75in</Top><Left>8.584in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsNoData.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>No BIOS data</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="BiosNote"><Top>1.45in</Top><Left>0in</Left><Height>0.3in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Newest</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: the newest BIOS seen on that exact model in the site, by its release date. No vendor catalog is used, so a model whose every device is behind the vendor&apos;s latest still shows as on the newest: check its age.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Behind</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: older firmware than the newest seen on its model.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Age</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: years since the installed BIOS was released, not since the device was bought.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Versions</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: how many BIOS versions a model runs. More than one usually means updates didn&apos;t reach every device.&quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox>
<Textbox Name="VersionsTitle"><Top>1.95in</Top><Left>0in</Left><Height>0.3in</Height><Width>6in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Versions by model, newest first</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox>
