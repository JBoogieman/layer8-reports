  <TablixCell><CellContents><Textbox Name="DeviceLowIn"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!DaysToLow.Value), Nothing, IIf(Fields!DaysToLow.Value &lt; 1, &quot;under a day&quot;, IIf(Fields!DaysToLow.Value = 1, &quot;1 day&quot;, Fields!DaysToLow.Value &amp; &quot; days&quot;)))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>=IIf(Fields!IsRunningOut.Value = 1, &quot;#0b0b0b&quot;, &quot;#52514e&quot;)</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
