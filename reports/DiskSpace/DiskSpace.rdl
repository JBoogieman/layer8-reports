Run></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Devices</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileLow"><Top>0.75in</Top><Left>2.146in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsLow.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Low on C:</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileRunningOut"><Top>0.75in</Top><Left>4.292in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsRunningOut.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Running out</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#fab219</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileMedianFree"><Top>0.75in</Top><Left>6.438in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!AllMedianFreeGB.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>GB free on C:, the median</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileNoData"><Top>0.75in</Top><Left>8.584in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsNoData.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>No disk data</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="DiskNote"><Top>1.45in</Top><Left>0in</Left><Height>0.3in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Low</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: less than &quot; &amp; Parameters!LowGB.Value &amp; &quot; GB free on C:.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Running out</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: not low yet, but at its recent rate C: gets there within &quot; &amp; Parameters!Days.Value &amp; &quot; days. Low in says when.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Per week</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: the trend through every free-space figure hardware inventory recorded for C: in the last &quot; &amp; Parameters!Days.Value &amp; &quot; days. It needs at least 3 of them, spread over a week. Inventory history keeps them until Delete Aged Inventory History removes them.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Median</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: half the devices have less free.&quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox>
