<DataSet Name="Devices">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
      <QueryParameter Name="@TargetBuild"><Value>=Parameters!TargetBuild.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 Windows releases: one row per device in a collection, with the Windows release it runs, whether that&apos;s the
-- target release, and for a device that&apos;s behind, why: Windows&apos; own check says whether its hardware stops the update.
-- The report groups the rows by release, and by model family and generation.
--
-- Parameters
--   @UserSIDs      The reader&apos;s, so the report shows only what their ConfigMgr security scopes allow. The report
--                  fills it in; &apos;disabled&apos; skips the check (for testing outside SSRS).
--   @CollectionID  The collection to report on, e.g. SMS00001 (All Systems).
--   @TargetBuild   The target release&apos;s build number, e.g. 26300. 0 (the default) means the release Windows offers
--                  most of the collection&apos;s devices, from its own upgrade check; with no check results, the newest
--                  release in the collection.
--
-- A device is on target, behind (an older release), newer, LTSC (a long-term servicing release, which doesn&apos;t take
-- feature updates, so it&apos;s never behind), a server (left out of the counts), or has no data.
--
-- Release names are listed below. The site&apos;s Windows servicing data has them too, but in a view the report server&apos;s
-- account can&apos;t read (vSMS_WindowsServicingLocalizedNames), and its support states are stale: in the lab it still
-- showed Windows 11 21H2 as current. A release missing from the list shows as &quot;Windows 11 (build N)&quot;.
--
-- Why behind: Windows&apos; compatibility check (the appraiser) runs on each device and writes a verdict for the newest
-- release it offers, which hardware inventory collects (Upgrade Experience Indicators). Red means hardware stops the
-- update, with codes saying what; Green means nothing&apos;s in the way. Microsoft documents neither the other verdicts
-- (Yellow, Orange) nor the codes, so the codes are matched by keyword and unknown ones are shown as they are. The
-- check runs against the newest release Windows offers, which can be newer than the target.

WITH Names AS (
    -- Each release&apos;s build, branch (0: general availability, 2: LTSC) and name. Add a line when a release comes out.
    SELECT Build, Branch, Release FROM (VALUES
        (28000, 0, &apos;Windows 11 26H1&apos;),
        (26300, 0, &apos;Windows 11 26H2&apos;),
        (26200, 0, &apos;Windows 11 25H2&apos;),
        (26100, 0, &apos;Windows 11 24H2&apos;),
        (26100, 2, &apos;Windows 11 LTSC 2024&apos;),
        (22631, 0, &apos;Windows 11 23H2&apos;),
        (22621, 0, &apos;Windows 11 22H2&apos;),
        (22000, 0, &apos;Windows 11 21H2&apos;),
        (19045, 0, &apos;Windows 10 22H2&apos;),
        (19044, 0, &apos;Windows 10 21H2&apos;),
        (19044, 2, &apos;Windows 10 LTSC 2021&apos;),
        (19043, 0, &apos;Windows 10 21H1&apos;),
        (19042, 0, &apos;Windows 10 20H2&apos;),
        (17763, 2, &apos;Windows 10 LTSC 2019&apos;)
    ) r (Build, Branch, Release)
),
Verdicts AS (
    -- Each device&apos;s verdict for the newest release it was checked against. The UNV key holds no verdict.
    SELECT ResourceID,
        LTRIM(RTRIM(UpgExU0)) AS Verdict,
        Version0 AS CheckedCode,
        NULLIF(LTRIM(RTRIM(Reason0)), &apos;&apos;) AS ReasonCodes,
        ROW_NUMBER() OVER (PARTITION BY ResourceID ORDER BY RIGHT(Version0, 4) DESC, Version0 DESC) AS Newest
    FROM fn_rbac_GS_UPGRADE_EXPERIENCE_INDICATORS(@UserSIDs)
    WHERE Version0 &lt;&gt; &apos;UNV&apos; AND NULLIF(LTRIM(RTRIM(UpgExU0)), &apos;&apos;) IS NOT NULL
),
Base AS (
    SELECT
        sys.ResourceID,
        sys.Name0 AS Device,
        CASE
            WHEN cs.Manufacturer0 LIKE &apos;LENOVO%&apos;                                 THEN &apos;Lenovo&apos;
            WHEN cs.Manufacturer0 LIKE &apos;Dell%&apos;                                   THEN &apos;Dell&apos;
            WHEN cs.Manufacturer0 LIKE &apos;HP%&apos; OR cs.Manufacturer0 LIKE &apos;Hewlett%&apos; THEN &apos;HP&apos;
            WHEN cs.Manufacturer0 LIKE &apos;Microsoft%&apos;                              THEN &apos;Microsoft&apos;
            WHEN cs.Manufacturer0 LIKE &apos;VMware%&apos;                                 THEN &apos;VMware&apos;
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Manufacturer0)), &apos;&apos;), &apos;Unknown&apos;)
        END AS Manufacturer,
        CASE
            WHEN cs.Manufacturer0 LIKE &apos;LENOVO%&apos; AND NULLIF(LTRIM(RTRIM(csp.Version0)), &apos;&apos;) IS NOT NULL
                 AND csp.Version0 NOT LIKE &apos;Lenovo&apos; THEN LTRIM(RTRIM(csp.Version0))
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Model0)), &apos;&apos;), &apos;Unknown&apos;)
        END AS Model,
        os.Caption0 AS OSCaption,
        TRY_CAST(os.BuildNumber0 AS int) AS BuildNo,
        ISNULL(sys.OSBranch01, 0) AS Branch,          -- 0: general availability, 2: long-term servicing (LTSC)
        os.InstallDate0 AS OnItSince,                 -- the device&apos;s local time; every feature update resets it
        ch.LastActiveTime AS LastActiveUtc,           -- UTC
        v.Verdict,
        v.CheckedCode,
        v.ReasonCodes
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM(@UserSIDs) cs           ON cs.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM_PRODUCT(@UserSIDs) csp  ON csp.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_OPERATING_SYSTEM(@UserSIDs) os          ON os.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_CH_ClientSummary(@UserSIDs) ch             ON ch.ResourceID = sys.ResourceID
    LEFT JOIN Verdicts v                                         ON v.ResourceID = sys.ResourceID AND v.Newest = 1
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Devices AS (
    SELECT
        b.*,
        -- Family and generation exactly as Fleet by model splits them, so the reports agree.
        CASE
            WHEN b.Manufacturer = &apos;Lenovo&apos; AND PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) &gt; 0 THEN LEFT(b.Model, PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) - 1)
            WHEN b.Manufacturer = &apos;HP&apos; AND PATINDEX(&apos;% G[0-9]%&apos;, b.Model) &gt; 0       THEN LEFT(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) - 1)
            ELSE b.Model
        END AS Family,
        CASE
            WHEN b.Manufacturer = &apos;Lenovo&apos; AND PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) &gt; 0
                THEN LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) + 1, 6))
            WHEN b.Manufacturer = &apos;HP&apos; AND PATINDEX(&apos;% G[0-9]%&apos;, b.Model) &gt; 0
                THEN LEFT(LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) + 1, 4)) + &apos; &apos;, CHARINDEX(&apos; &apos;, LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) + 1, 4)) + &apos; &apos;) - 1)
            ELSE &apos;&apos;
        END AS Generation,
        CASE WHEN b.OSCaption LIKE &apos;%Server%&apos; THEN 1 ELSE 0 END AS IsServer,
        -- The release&apos;s name: from the list for its build and branch, else from the caption or the build.
        COALESCE(
            n.Release,
            CASE WHEN b.OSCaption LIKE &apos;%Server%&apos; THEN REPLACE(b.OSCaption, &apos;Microsoft &apos;, &apos;&apos;) END,
            CASE WHEN b.BuildNo &gt;= 22000 THEN &apos;Windows 11 (build &apos; WHEN b.BuildNo IS NOT NULL THEN &apos;Windows 10 (build &apos; END + CAST(b.BuildNo AS varchar(10)) + &apos;)&apos;,
            &apos;Unknown&apos;) AS Release,
        -- The release Windows checked it against: &quot;26H2&quot; from the appraiser&apos;s key &quot;GE26H2&quot;.
        CASE WHEN b.CheckedCode LIKE &apos;%[0-9][0-9]H[12]&apos; THEN RIGHT(b.CheckedCode, 4) END AS CheckedVersion,
        -- The reason codes without the appraiser&apos;s trailing comma, and without &quot;None&quot;.
        NULLIF(REPLACE(CASE WHEN b.ReasonCodes LIKE &apos;%,&apos; THEN LEFT(b.ReasonCodes, LEN(b.ReasonCodes) - 1) ELSE b.ReasonCodes END, &apos;None&apos;, &apos;&apos;), &apos;&apos;) AS Reasons
    FROM Base b
    OUTER APPLY (SELECT TOP 1 nm.Release FROM Names nm WHERE nm.Build = b.BuildNo
                 ORDER BY CASE WHEN nm.Branch = b.Branch THEN 0 ELSE 1 END, nm.Branch) n
),
Offered AS (
    -- The release Windows offers most of the collection&apos;s devices.
    SELECT TOP 1 CheckedVersion FROM Devices
    WHERE CheckedVersion IS NOT NULL AND IsServer = 0
    GROUP BY CheckedVersion
    ORDER BY COUNT(*) DESC, CheckedVersion DESC
),
Target AS (
    -- The reader&apos;s target, else what Windows offers most of the devices, else the newest release in the collection.
    SELECT COALESCE(
        NULLIF(@TargetBuild, 0),
        (SELECT MAX(nm.Build) FROM Names nm JOIN Offered o ON nm.Release = &apos;Windows 11 &apos; + o.CheckedVersion WHERE nm.Branch = 0),
        (SELECT MAX(BuildNo) FROM Devices WHERE IsServer = 0 AND Branch &lt;&gt; 2)) AS Build
),
Classified AS (
    SELECT
        d.*,
        t.Build AS TargetBuildNo,
        CASE
            WHEN d.IsServer = 1        THEN &apos;Server&apos;
            WHEN d.Branch = 2          THEN &apos;LTSC&apos;
            WHEN d.BuildNo IS NULL     THEN &apos;No data&apos;
            WHEN d.BuildNo = t.Build   THEN &apos;On target&apos;
            WHEN d.BuildNo &gt; t.Build   THEN &apos;Newer&apos;
            ELSE &apos;Behind&apos;
        END AS Status
    FROM Devices d
    CROSS JOIN Target t
)
SELECT
    c.Device,
    c.Manufacturer,
    c.Family,
    c.Generation,
    c.Model,
    c.Release,
    c.BuildNo,
    c.Status,
    CASE WHEN c.Status = &apos;On target&apos; THEN 1 ELSE 0 END AS IsOnTarget,
    CASE WHEN c.Status = &apos;Behind&apos; THEN 1 ELSE 0 END AS IsBehind,
    CASE WHEN c.Status = &apos;Behind&apos; AND c.Verdict = &apos;Red&apos; THEN 1 ELSE 0 END AS IsBlocked,
    CASE WHEN c.IsServer = 0 AND c.OSCaption LIKE &apos;%Windows 10%&apos; THEN 1 ELSE 0 END AS OnWindows10,
    c.OnItSince,
    -- UTC in the site; shown in the site database server&apos;s time zone, like the other reports&apos; times.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), c.LastActiveUtc) AS LastActive,
    -- Why a device that&apos;s behind is behind. A code is matched by its stem (CpuFms and CpuCores are both the processor).
    CASE
        WHEN c.Status &lt;&gt; &apos;Behind&apos;  THEN NULL
        WHEN c.Verdict IS NULL     THEN &apos;Not checked&apos;
        WHEN c.Verdict = &apos;Green&apos;   THEN &apos;Nothing in the way&apos;
        WHEN c.Verdict = &apos;Red&apos;     THEN &apos;Hardware: &apos; + ISNULL(STUFF(
              CASE WHEN c.Reasons LIKE &apos;%Cpu%&apos; OR c.Reasons LIKE &apos;%Processor%&apos;                    THEN &apos;, Processor&apos;            ELSE &apos;&apos; END
            + CASE WHEN c.Reasons LIKE &apos;%Tpm%&apos;                                                     THEN &apos;, TPM&apos;                  ELSE &apos;&apos; END
            + CASE WHEN c.Reasons LIKE &apos;%Uefi%&apos; OR c.Reasons LIKE &apos;%SecureBoot%&apos;                   THEN &apos;, UEFI and Secure Boot&apos; ELSE &apos;&apos; END
            + CASE WHEN c.Reasons LIKE &apos;%Memory%&apos;                                                  THEN &apos;, Memory&apos;               ELSE &apos;&apos; END
            + CASE WHEN c.Reasons LIKE &apos;%Storage%&apos; OR c.Reasons LIKE &apos;%DriveSize%&apos; OR c.Reasons LIKE &apos;%Disk%&apos; THEN &apos;, Disk space&apos; ELSE &apos;&apos; END,
            1, 2, &apos;&apos;), ISNULL(c.Reasons, &apos;not stated&apos;))
        ELSE &apos;Check first (&apos; + c.Verdict + &apos;)&apos;
    END AS WhyBehind,
    c.CheckedVersion,
    c.Reasons AS ReasonCodes,
    -- The target, named, for the subtitle.
    COALESCE((SELECT TOP 1 nm.Release FROM Names nm WHERE nm.Build = c.TargetBuildNo ORDER BY nm.Branch), &apos;Windows (build &apos; + CAST(c.TargetBuildNo AS varchar(10)) + &apos;)&apos;) AS TargetRelease,
    c.TargetBuildNo
FROM Classified c
ORDER BY c.Family, c.Generation, c.Device;
</CommandText>
    <Timeout>600</Timeout></Query>
  <Fields><Field Name="Device"><DataField>Device</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Manufacturer"><DataField>Manufacturer</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Family"><DataField>Family</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Generation"><DataField>Generation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Model"><DataField>Model</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Release"><DataField>Release</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BuildNo"><DataField>BuildNo</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="IsOnTarget"><DataField>IsOnTarget</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsBehind"><DataField>IsBehind</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsBlocked"><DataField>IsBlocked</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="OnWindows10"><DataField>OnWindows10</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="OnItSince"><DataField>OnItSince</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="LastActive"><DataField>LastActive</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="WhyBehind"><DataField>WhyBehind</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CheckedVersion"><DataField>CheckedVersion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ReasonCodes"><DataField>ReasonCodes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TargetRelease"><DataField>TargetRelease</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TargetBuildNo"><DataField>TargetBuildNo</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields>
</DataSet>
<DataSet Name="TargetChoices">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 Windows releases: the choices for the report&apos;s Target release. First &quot;What Windows offers&quot; (0, the default),
-- then each Windows client release in the collection, newest first. The release list is the same as in
-- WindowsReleases.sql: keep the two in step.
--
-- Parameters
--   @UserSIDs      The reader&apos;s, so only what their ConfigMgr security scopes allow is listed. &apos;disabled&apos; skips the
--                  check (for testing outside SSRS).
--   @CollectionID  The report&apos;s collection.

WITH Names AS (
    -- Each release&apos;s build, branch (0: general availability, 2: LTSC) and name. Add a line when a release comes out.
    SELECT Build, Branch, Release FROM (VALUES
        (28000, 0, &apos;Windows 11 26H1&apos;),
        (26300, 0, &apos;Windows 11 26H2&apos;),
        (26200, 0, &apos;Windows 11 25H2&apos;),
        (26100, 0, &apos;Windows 11 24H2&apos;),
        (26100, 2, &apos;Windows 11 LTSC 2024&apos;),
        (22631, 0, &apos;Windows 11 23H2&apos;),
        (22621, 0, &apos;Windows 11 22H2&apos;),
        (22000, 0, &apos;Windows 11 21H2&apos;),
        (19045, 0, &apos;Windows 10 22H2&apos;),
        (19044, 0, &apos;Windows 10 21H2&apos;),
        (19044, 2, &apos;Windows 10 LTSC 2021&apos;),
        (19043, 0, &apos;Windows 10 21H1&apos;),
        (19042, 0, &apos;Windows 10 20H2&apos;),
        (17763, 2, &apos;Windows 10 LTSC 2019&apos;)
    ) r (Build, Branch, Release)
),
Builds AS (
    -- Client releases only: servers and long-term servicing (LTSC) devices are never measured against a target.
    SELECT DISTINCT TRY_CAST(os.BuildNumber0 AS int) AS Build
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys                ON sys.ResourceID = fcm.ResourceID
    JOIN fn_rbac_GS_OPERATING_SYSTEM(@UserSIDs) os      ON os.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
      AND os.Caption0 NOT LIKE &apos;%Server%&apos;
      AND ISNULL(sys.OSBranch01, 0) &lt;&gt; 2
      AND TRY_CAST(os.BuildNumber0 AS int) IS NOT NULL
)
SELECT Build, Label
FROM (
    SELECT 0 AS Build, &apos;What Windows offers (the default)&apos; AS Label, 0 AS Choice
    UNION ALL
    SELECT b.Build,
        ISNULL((SELECT TOP 1 nm.Release FROM Names nm WHERE nm.Build = b.Build AND nm.Branch = 0),
               CASE WHEN b.Build &gt;= 22000 THEN &apos;Windows 11&apos; ELSE &apos;Windows 10&apos; END) + &apos; (build &apos; + CAST(b.Build AS varchar(10)) + &apos;)&apos;,
        1
    FROM Builds b
) r
ORDER BY Choice, Build DESC;
</CommandText>
    <Timeout>600</Timeout></Query>
  <Fields><Field Name="Build"><DataField>Build</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Label"><DataField>Label</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields>
</DataSet>
<DataSet Name="Freshness">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 data freshness: how current the hardware inventory behind a report is, for the report&apos;s page footer. Every
-- report runs this for its own collection, so the footer counts the same devices the report does.
--
-- Parameters
--   @UserSIDs      The reader&apos;s, so only devices their ConfigMgr security scopes allow are counted. The report fills
--                  it in; &apos;disabled&apos; skips the check (for testing outside SSRS).
--   @CollectionID  The report&apos;s collection.
--
-- One row: the devices, how many have never sent hardware inventory, the newest inventory, and the median age of the
-- devices&apos; latest inventory (half the devices sent theirs more recently than that). The median is worked out here
-- because the report server has none.

WITH Devices AS (
    SELECT ch.LastHW                                     -- the last hardware inventory, in UTC
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys                 ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_CH_ClientSummary(@UserSIDs) ch     ON ch.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Aged AS (
    SELECT LastHW,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY DATEDIFF(minute, LastHW, GETUTCDATE()) / 1440.0) OVER () AS MedianAgeDays
    FROM Devices
)
SELECT
    COUNT(*) AS Devices,
    ISNULL(SUM(CASE WHEN LastHW IS NULL THEN 1 ELSE 0 END), 0) AS NoInventory,
    -- Shown in the site database server&apos;s time zone, like the reports&apos; other times.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), MAX(LastHW)) AS NewestInventory,
    CAST(MAX(MedianAgeDays) AS decimal(9, 1)) AS MedianAgeDays
FROM Aged;
</CommandText></Query>
  <Fields>
    <Field Name="Devices"><DataField>Devices</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    <Field Name="NoInventory"><DataField>NoInventory</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    <Field Name="NewestInventory"><DataField>NewestInventory</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
    <Field Name="MedianAgeDays"><DataField>MedianAgeDays</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
  </Fields>
</DataSet>
</DataSets>
<Body><ReportItems><Textbox Name="Title"><Top>0in</Top><Left>0in</Left><Height>0.38in</Height><Width>6in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Windows releases</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="Subtitle"><Top>0.38in</Top><Left>0in</Left><Height>0.25in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!CollectionID.Label &amp; &quot;  ·  &quot; &amp; CountRows(&quot;Devices&quot;) &amp; &quot; devices  ·  target &quot; &amp; First(Fields!TargetRelease.Value, &quot;Devices&quot;) &amp; &quot; (build &quot; &amp; First(Fields!TargetBuildNo.Value, &quot;Devices&quot;) &amp; &quot;)&quot; &amp; IIf(Parameters!TargetBuild.Value = 0, &quot;, the release Windows offers most of them&quot;, &quot;&quot;) &amp; &quot;  ·  run &quot; &amp; Format(Globals!ExecutionTime, &quot;g&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="TileDevices"><Top>0.75in</Top><Left>0.000in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows(&quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Devices</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileOnTarget"><Top>0.75in</Top><Left>2.146in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsOnTarget.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>On the target release</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#0ca30c</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileBehind"><Top>0.75in</Top><Left>4.292in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsBehind.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Behind</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#fab219</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileBlocked"><Top>0.75in</Top><Left>6.438in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsBlocked.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Behind, blocked by hardware</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileWindows10"><Top>0.75in</Top><Left>8.584in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!OnWindows10.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Still on Windows 10</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="ReleasesNote"><Top>1.45in</Top><Left>0in</Left><Height>0.3in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>On target</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: runs the target release. Unless you pick one, that&apos;s the release Windows offers most of these devices.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Behind</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: runs an older release than the target.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Why behind</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: Windows&apos; own check on the device. Hardware: what stops the update (these are Blocked). Nothing in the way: it just hasn&apos;t been updated. Check first: a verdict Microsoft doesn&apos;t document (Yellow or Orange). Not checked: no result has reached the site. Windows checks against the newest release it offers, which can be newer than the target.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>On it since</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: when the device got its current release. Every feature update resets it.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Not counted</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: servers, and LTSC releases, which don&apos;t take feature updates.&quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox>
<Textbox Name="ReleasesTitle"><Top>1.95in</Top><Left>0in</Left><Height>0.3in</Height><Width>6in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Releases, newest first</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox>
