  <TablixCell><CellContents><Textbox Name="RelRelease"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Release.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>=IIf(Max(Fields!IsOnTarget.Value) = 1, &quot;SemiBold&quot;, &quot;Normal&quot;)</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
  <TablixCell><CellContents><Textbox Name="RelBuild"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Max(Fields!BuildNo.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
  <TablixCell><CellContents><Textbox Name="RelDevices"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows()</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
  <TablixCell><CellContents><Textbox Name="RelShare"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows() / CountRows(&quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Format>0%</Format><Color>#52514e</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
  <TablixCell><CellContents><Textbox Name="RelStatus"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!Status.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>=IIf(First(Fields!Status.Value) = &quot;On target&quot;, &quot;#0ca30c&quot;, IIf(First(Fields!Status.Value) = &quot;Behind&quot;, &quot;#0b0b0b&quot;, &quot;#52514e&quot;))</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
  <TablixCell><CellContents><Textbox Name="RelBlocked"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsBlocked.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Format>#,0</Format><Color>=IIf(Sum(Fields!IsBlocked.Value) = 0, &quot;#c3c2b7&quot;, &quot;#d03b3b&quot;)</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
  <TablixCell><CellContents><Textbox Name="RelModels"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(Fields!Model.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border><BottomBorder><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></BottomBorder></Style></Textbox></CellContents></TablixCell>
