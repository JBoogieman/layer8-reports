  <PageFooter><Height>0.3in</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Textbox Name="Footer"><Top>0.05in</Top><Left>0in</Left><Height>0.2in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Hardware inventory: &quot; &amp; IIf(First(Fields!Devices.Value, &quot;Freshness&quot;) = 0, &quot;no devices&quot;, IIf(First(Fields!NoInventory.Value, &quot;Freshness&quot;) = First(Fields!Devices.Value, &quot;Freshness&quot;), &quot;none yet from any of the &quot; &amp; Format(First(Fields!Devices.Value, &quot;Freshness&quot;), &quot;#,0&quot;) &amp; &quot; devices&quot;, &quot;newest &quot; &amp; Format(First(Fields!NewestInventory.Value, &quot;Freshness&quot;), &quot;d&quot;) &amp; &quot;, median age &quot; &amp; Format(First(Fields!MedianAgeDays.Value, &quot;Freshness&quot;), &quot;0.#&quot;) &amp; &quot; days&quot; &amp; IIf(First(Fields!NoInventory.Value, &quot;Freshness&quot;) &gt; 0, &quot;, none yet from &quot; &amp; Format(First(Fields!NoInventory.Value, &quot;Freshness&quot;), &quot;#,0&quot;) &amp; &quot; of &quot; &amp; Format(First(Fields!Devices.Value, &quot;Freshness&quot;), &quot;#,0&quot;) &amp; &quot; devices&quot;, &quot;&quot;))) &amp; &quot;  ·  Layer8 reports  ·  github.com/JBoogieman/layer8-reports  ·  page &quot; &amp; Globals!PageNumber &amp; &quot; of &quot; &amp; Globals!TotalPages</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#898781</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox></ReportItems><Style /></PageFooter>
