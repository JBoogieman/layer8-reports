ntSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileInuse"><Top>0.75in</Top><Left>2.146in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!Status.Value = "In use", 1, 0), "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>In use</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#0ca30c</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileUnused"><Top>0.75in</Top><Left>4.292in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!Status.Value = "Unused", 1, 0), "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Unused</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#fab219</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileNotseen"><Top>0.75in</Top><Left>6.438in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!Status.Value = "Not seen", 1, 0), "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Not seen</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileUnknown"><Top>0.75in</Top><Left>8.584in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!Status.Value = "Unknown", 1, 0), "Devices")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Unknown</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#898781</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="StatusNote"><Top>1.45in</Top><Left>0in</Left><Height>0.3in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="In use: someone signed in at it in the last " &amp; Parameters!IdleDays.Value &amp; " days.   Unused: on and checking in with the site, but nobody signed in (the ones to reclaim).   Not seen: no contact with the site in that time (in a drawer, or gone).   Unknown: the site has no sign-in data for it."</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Chart Name="StatusByFamily">
