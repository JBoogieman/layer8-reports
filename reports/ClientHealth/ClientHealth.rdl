<DataSet Name="Devices">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 Client health: one row per device in a collection, with whether its ConfigMgr client is active, passing its
-- own health check, and keeping its inventory, policy requests and heartbeat current. The report groups the rows by
-- model family and generation, and counts what&apos;s wrong.
--
-- Parameters
--   @UserSIDs      The reader&apos;s, so the report shows only what their ConfigMgr security scopes allow. The report
--                  fills it in; &apos;disabled&apos; skips the check (for testing outside SSRS).
--   @CollectionID  The collection to report on, e.g. SMS00001 (All Systems).
--
-- Every judgement is the site&apos;s own, from its client status summary: active or inactive, and each kind of activity
-- current or stale, by the site&apos;s Client Status Settings (7 days each by default); and the client&apos;s health check
-- result as the site labels it (&quot;Active/Pass&quot;, &quot;Active/Fail&quot;). A device is the first of: no client status, inactive,
-- failing its health check, stale (with what&apos;s stale), or healthy.
--
-- The summary&apos;s times are UTC and are shown in the site database server&apos;s time zone. LastHealthEvaluation is taken to
-- be UTC like the rest of the summary; that one wasn&apos;t checked separately.

WITH Base AS (
    SELECT
        sys.ResourceID,
        sys.Name0 AS Device,
        CASE
            WHEN cs.Manufacturer0 LIKE &apos;LENOVO%&apos;                                 THEN &apos;Lenovo&apos;
            WHEN cs.Manufacturer0 LIKE &apos;Dell%&apos;                                   THEN &apos;Dell&apos;
            WHEN cs.Manufacturer0 LIKE &apos;HP%&apos; OR cs.Manufacturer0 LIKE &apos;Hewlett%&apos; THEN &apos;HP&apos;
            WHEN cs.Manufacturer0 LIKE &apos;Microsoft%&apos;                              THEN &apos;Microsoft&apos;
            WHEN cs.Manufacturer0 LIKE &apos;VMware%&apos;                                 THEN &apos;VMware&apos;
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Manufacturer0)), &apos;&apos;), &apos;Unknown&apos;)
        END AS Manufacturer,
        CASE
            WHEN cs.Manufacturer0 LIKE &apos;LENOVO%&apos; AND NULLIF(LTRIM(RTRIM(csp.Version0)), &apos;&apos;) IS NOT NULL
                 AND csp.Version0 NOT LIKE &apos;Lenovo&apos; THEN LTRIM(RTRIM(csp.Version0))
            ELSE ISNULL(NULLIF(LTRIM(RTRIM(cs.Model0)), &apos;&apos;), &apos;Unknown&apos;)
        END AS Model,
        CASE WHEN ch.ResourceID IS NULL THEN 0 ELSE 1 END AS HasStatus,
        ch.ClientActiveStatus,
        ch.ClientStateDescription AS ClientState,
        ch.IsActiveHW,
        ch.IsActivePolicyRequest,
        ch.IsActiveDDR,
        ch.LastActiveTime,          -- UTC, like the times below
        ch.LastPolicyRequest,
        ch.LastHW,
        ch.LastDDR,
        ch.LastHealthEvaluation
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM(@UserSIDs) cs           ON cs.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_GS_COMPUTER_SYSTEM_PRODUCT(@UserSIDs) csp  ON csp.ResourceID = sys.ResourceID
    LEFT JOIN fn_rbac_CH_ClientSummary(@UserSIDs) ch             ON ch.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Devices AS (
    SELECT
        b.*,
        -- Family and generation exactly as Fleet by model splits them, so the reports agree.
        CASE
            WHEN b.Manufacturer = &apos;Lenovo&apos; AND PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) &gt; 0 THEN LEFT(b.Model, PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) - 1)
            WHEN b.Manufacturer = &apos;HP&apos; AND PATINDEX(&apos;% G[0-9]%&apos;, b.Model) &gt; 0       THEN LEFT(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) - 1)
            ELSE b.Model
        END AS Family,
        CASE
            WHEN b.Manufacturer = &apos;Lenovo&apos; AND PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) &gt; 0
                THEN LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% Gen [0-9]%&apos;, b.Model) + 1, 6))
            WHEN b.Manufacturer = &apos;HP&apos; AND PATINDEX(&apos;% G[0-9]%&apos;, b.Model) &gt; 0
                THEN LEFT(LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) + 1, 4)) + &apos; &apos;, CHARINDEX(&apos; &apos;, LTRIM(SUBSTRING(b.Model, PATINDEX(&apos;% G[0-9]%&apos;, b.Model) + 1, 4)) + &apos; &apos;) - 1)
            ELSE &apos;&apos;
        END AS Generation,
        CASE WHEN b.IsActiveHW = 0 THEN 1 ELSE 0 END AS InventoryStale,
        CASE WHEN b.IsActivePolicyRequest = 0 THEN 1 ELSE 0 END AS PolicyStale,
        CASE WHEN b.IsActiveDDR = 0 THEN 1 ELSE 0 END AS HeartbeatStale,
        CASE
            WHEN b.HasStatus = 0                         THEN &apos;No client status&apos;
            WHEN b.ClientActiveStatus = 0                THEN &apos;Inactive&apos;
            WHEN b.ClientState LIKE &apos;%/Fail%&apos;            THEN &apos;Failing health check&apos;
            WHEN b.IsActiveHW = 0 OR b.IsActivePolicyRequest = 0 OR b.IsActiveDDR = 0 THEN &apos;Stale&apos;
            ELSE &apos;Healthy&apos;
        END AS Status
    FROM Base b
)
SELECT
    d.Device,
    d.Manufacturer,
    d.Family,
    d.Generation,
    d.Model,
    d.ClientState,
    d.Status,
    -- What&apos;s wrong, in words, for the summary: &quot;Stale: inventory, policy&quot;.
    CASE
        WHEN d.Status = &apos;Stale&apos; THEN &apos;Stale: &apos; + STUFF(
              CASE WHEN d.InventoryStale = 1 THEN &apos;, inventory&apos; ELSE &apos;&apos; END
            + CASE WHEN d.PolicyStale = 1    THEN &apos;, policy&apos;    ELSE &apos;&apos; END
            + CASE WHEN d.HeartbeatStale = 1 THEN &apos;, heartbeat&apos; ELSE &apos;&apos; END, 1, 2, &apos;&apos;)
        WHEN d.Status = &apos;Healthy&apos; THEN NULL
        ELSE d.Status
    END AS Problem,
    CASE WHEN d.Status = &apos;Healthy&apos; THEN 1 ELSE 0 END AS IsHealthy,
    CASE WHEN d.Status = &apos;Stale&apos; THEN 1 ELSE 0 END AS IsStale,
    CASE WHEN d.Status = &apos;Failing health check&apos; THEN 1 ELSE 0 END AS IsFailing,
    CASE WHEN d.Status = &apos;Inactive&apos; THEN 1 ELSE 0 END AS IsInactive,
    CASE WHEN d.Status = &apos;No client status&apos; THEN 1 ELSE 0 END AS IsNoStatus,
    CASE WHEN d.Status &lt;&gt; &apos;Healthy&apos; THEN 1 ELSE 0 END AS IsUnhealthy,
    d.InventoryStale,
    d.PolicyStale,
    d.HeartbeatStale,
    -- UTC in the site; shown in the site database server&apos;s time zone, like the other reports&apos; times.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), d.LastActiveTime) AS LastContact,
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), d.LastPolicyRequest) AS LastPolicy,
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), d.LastHW) AS LastInventory,
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), d.LastDDR) AS LastHeartbeat,
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), d.LastHealthEvaluation) AS LastHealthCheck
FROM Devices d
ORDER BY d.Family, d.Generation, d.Device;
</CommandText>
    <Timeout>600</Timeout></Query>
  <Fields><Field Name="Device"><DataField>Device</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Manufacturer"><DataField>Manufacturer</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Family"><DataField>Family</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Generation"><DataField>Generation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Model"><DataField>Model</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ClientState"><DataField>ClientState</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Problem"><DataField>Problem</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="IsHealthy"><DataField>IsHealthy</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsStale"><DataField>IsStale</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsFailing"><DataField>IsFailing</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsInactive"><DataField>IsInactive</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsNoStatus"><DataField>IsNoStatus</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IsUnhealthy"><DataField>IsUnhealthy</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="InventoryStale"><DataField>InventoryStale</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="PolicyStale"><DataField>PolicyStale</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="HeartbeatStale"><DataField>HeartbeatStale</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="LastContact"><DataField>LastContact</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="LastPolicy"><DataField>LastPolicy</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="LastInventory"><DataField>LastInventory</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="LastHeartbeat"><DataField>LastHeartbeat</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="LastHealthCheck"><DataField>LastHealthCheck</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields>
</DataSet>
<DataSet Name="Freshness">
  <Query><DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
    <QueryParameters>
      <QueryParameter Name="@UserSIDs"><Value>=Parameters!UserSIDs.Value</Value></QueryParameter>
      <QueryParameter Name="@CollectionID"><Value>=Parameters!CollectionID.Value</Value></QueryParameter>
    </QueryParameters>
    <CommandText>-- Layer8 data freshness: how current the hardware inventory behind a report is, for the report&apos;s page footer. Every
-- report runs this for its own collection, so the footer counts the same devices the report does.
--
-- Parameters
--   @UserSIDs      The reader&apos;s, so only devices their ConfigMgr security scopes allow are counted. The report fills
--                  it in; &apos;disabled&apos; skips the check (for testing outside SSRS).
--   @CollectionID  The report&apos;s collection.
--
-- One row: the devices, how many have never sent hardware inventory, the newest inventory, and the median age of the
-- devices&apos; latest inventory (half the devices sent theirs more recently than that). The median is worked out here
-- because the report server has none.

WITH Devices AS (
    SELECT ch.LastHW                                     -- the last hardware inventory, in UTC
    FROM fn_rbac_FullCollectionMembership(@UserSIDs) fcm
    JOIN fn_rbac_R_System(@UserSIDs) sys                 ON sys.ResourceID = fcm.ResourceID
    LEFT JOIN fn_rbac_CH_ClientSummary(@UserSIDs) ch     ON ch.ResourceID = sys.ResourceID
    WHERE fcm.CollectionID = @CollectionID
      AND ISNULL(sys.Obsolete0, 0) = 0
      AND sys.Client0 = 1
),
Aged AS (
    SELECT LastHW,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY DATEDIFF(minute, LastHW, GETUTCDATE()) / 1440.0) OVER () AS MedianAgeDays
    FROM Devices
)
SELECT
    COUNT(*) AS Devices,
    ISNULL(SUM(CASE WHEN LastHW IS NULL THEN 1 ELSE 0 END), 0) AS NoInventory,
    -- Shown in the site database server&apos;s time zone, like the reports&apos; other times.
    DATEADD(minute, DATEDIFF(minute, GETUTCDATE(), GETDATE()), MAX(LastHW)) AS NewestInventory,
    CAST(MAX(MedianAgeDays) AS decimal(9, 1)) AS MedianAgeDays
FROM Aged;
</CommandText></Query>
  <Fields>
    <Field Name="Devices"><DataField>Devices</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    <Field Name="NoInventory"><DataField>NoInventory</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
    <Field Name="NewestInventory"><DataField>NewestInventory</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
    <Field Name="MedianAgeDays"><DataField>MedianAgeDays</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
  </Fields>
</DataSet>
</DataSets>
<Body><ReportItems><Textbox Name="Title"><Top>0in</Top><Left>0in</Left><Height>0.38in</Height><Width>6in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Client health</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="Subtitle"><Top>0.38in</Top><Left>0in</Left><Height>0.25in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!CollectionID.Label &amp; &quot;  ·  &quot; &amp; CountRows(&quot;Devices&quot;) &amp; &quot; devices&quot; &amp; IIf(Sum(Fields!IsNoStatus.Value, &quot;Devices&quot;) &gt; 0, &quot;, &quot; &amp; Sum(Fields!IsNoStatus.Value, &quot;Devices&quot;) &amp; &quot; with no client status&quot;, &quot;&quot;) &amp; &quot;  ·  judged by the site&apos;s own client status settings  ·  run &quot; &amp; Format(Globals!ExecutionTime, &quot;g&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox><Textbox Name="TileDevices"><Top>0.75in</Top><Left>0.000in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountRows(&quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Devices</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#c3c2b7</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileHealthy"><Top>0.75in</Top><Left>2.146in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsHealthy.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Healthy</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#0ca30c</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileStale"><Top>0.75in</Top><Left>4.292in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsStale.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Something stale</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#fab219</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileFailing"><Top>0.75in</Top><Left>6.438in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsFailing.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Failing health check</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="TileInactive"><Top>0.75in</Top><Left>8.584in</Left><Height>0.62in</Height><Width>1.896in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!IsInactive.Value, &quot;Devices&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>SemiBold</FontWeight><Format>#,0</Format><Color>#0b0b0b</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Inactive</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Top</VerticalAlign><PaddingLeft>8pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Color>#e1e0d9</Color><Style>Solid</Style><Width>0.75pt</Width></Border><LeftBorder><Color>#d03b3b</Color><Style>Solid</Style><Width>3pt</Width></LeftBorder><BackgroundColor>#ffffff</BackgroundColor></Style></Textbox><Textbox Name="HealthNote"><Top>1.45in</Top><Left>0in</Left><Height>0.3in</Height><Width>10.5in</Width><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Inactive</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: the site counts the client inactive, by its Client Status Settings (7 days by default).   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Failing health check</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: the client&apos;s own health check failed, as the site reports it.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Stale</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: active, but its hardware inventory, policy requests or heartbeat discovery haven&apos;t reached the site within those settings. What&apos;s wrong says which.   &quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun><TextRun><Value>Dates</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>SemiBold</FontWeight><Color>#0b0b0b</Color></Style></TextRun><TextRun><Value>=&quot;: the last of each that reached the site. On a model row, the oldest among its devices.&quot;</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#52514e</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom><Border><Style>None</Style></Border></Style></Textbox>
